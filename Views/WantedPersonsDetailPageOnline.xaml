<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MostWanted.Views.WantedPersonsDetailPageOnline"
             xmlns:vm="clr-namespace:MostWanted.ViewsModels"
             Title="{Binding WantedPerson.Name}"
             x:DataType="vm:WantedPersonOnlineViewModel"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Card-style container -->
            <Border Stroke="{DynamicResource PrimaryColor}" 
                    StrokeThickness="2"
                    BackgroundColor="White"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                    <!-- Profile Image -->
                    <Image Source="{Binding WantedPerson.ImagePath}"
                           HeightRequest="150"
                           WidthRequest="150"
                           Aspect="AspectFill"
                           HorizontalOptions="Center">
                        <Image.Clip>
                            <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75"/>
                        </Image.Clip>
                    </Image>

                    <!-- Name as headline -->
                    <Label Text="{Binding WantedPerson.Name}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryColor}"
                           HorizontalOptions="Center" />

                    <!-- ID -->
                    <Label Text="ID:"
                           FontAttributes="Bold"
                           TextColor="Gray"/>
                    <Label Text="{Binding WantedPerson.Id}"
                           FontSize="16"
                           TextColor="Black"/>

                    <!-- Description -->
                    <Label Text="Description:"
                           FontAttributes="Bold"
                           TextColor="Gray"/>
                    <Label Text="{Binding WantedPerson.Description}"
                           FontSize="16"
                           TextColor="Black"
                           LineBreakMode="WordWrap"/>

                    <!-- Type -->
                    <Label Text="Type:"
                           FontAttributes="Bold"
                           TextColor="Gray"/>
                    <Label Text="{Binding WantedPerson.Type}"
                           FontSize="16"
                           TextColor="Black"/>

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">

                        <!-- Snap Button 
                        <Button Text="Snap"
            BackgroundColor="Blue"
            TextColor="White"
            Command="{Binding SnapCommand}" /> -->

                        <!-- Report Button -->
                        <Button Text="Report Spotted"
            BackgroundColor="Red"
            TextColor="White"
            Command="{Binding ReportSpottedCommand}" />

                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>