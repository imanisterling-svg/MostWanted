<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MostWanted.UpdateWantedPage"
             Title="Update Person">

    <VerticalStackLayout Padding="20">
        <Entry Text="{Binding Person.Name}" Placeholder="Name"/>
        <Entry Text="{Binding Person.Type}" Placeholder="Type"/>
        <Editor Text="{Binding Person.Description}" Placeholder="Description"/>

        <Button Text="Save"
                Command="{Binding SaveCommand}" />

        <Button Text="Cancel"
        Command="{Binding CancelCommand}" />
        
        
        
        

    </VerticalStackLayout>
</ContentPage>