             x:DataType="modelview:WantedPersonListViewModel"
             Title="Add Person">

    <Grid ColumnSpacing="1" RowSpacing="1" Padding="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0">
            <Label Text="Upload Wanted Person"
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   x:Name="LblCounter"
                   FontSize="22"
                   FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- Entry Form -->
        <VerticalStackLayout Padding="5" Grid.Row="1" Margin="9">
            <Entry Placeholder="The Name" Text="{Binding Name}" />
            <Entry Placeholder="Enter Person Description" Text="{Binding Description}" />
            <Entry Placeholder="Type of Offence" Text="{Binding Type}" />

            <Image x:Name="PersonImage"
       Source="{Binding ImagePath}"  
                HeightRequest="150"
       WidthRequest="150"
       Aspect="AspectFill"
       BackgroundColor="LightGray"
       Margin="0,5"/>


           

            <!-- Image Buttons -->
            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                <Button Text="Select Image" Clicked="Button_SelectImage_Clicked" />
                <Button Text="Take Photo" Clicked="Button_TakePhoto_Clicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Add Button -->
        
        
        <Button Text="Add Most Wanted"
                Grid.Row="2"
                Margin="9"
                IsEnabled="{Binding IsNotLoading}"
                Command="{Binding AddPersonCommand}" />

